{
  "name": "agentero-dsh-plugin",
  "version": "0.1.0",
  "description": "DeepSeek Harness bundle that connects Agentero to dsh",
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "files": [
    "cordis.patch.yml",
    "pnpm-workspace.yaml",
    "packages"
  ],
  "scripts": {
    "build": "node scripts/build-all.mjs",
    "prepare": "node scripts/build-all.mjs",
    "typecheck": "node scripts/build-all.mjs --noEmit"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "agentero-dsh-host": "file:./packages/host",
    "agentero-dsh-library": "file:./packages/library",
    "agentero-dsh-notes": "file:./packages/notes",
    "agentero-dsh-pdf": "file:./packages/pdf"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.16",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.18",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.16",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poco-ai/agentero-dsh-plugin.git"
  }
}
