{
  "name": "@poco-ai/agentero-dsh",
  "version": "0.1.3",
  "description": "DeepSeek Harness bundle that connects Agentero to dsh",
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "files": [
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node scripts/build-all.mjs",
    "typecheck": "node scripts/build-all.mjs --noEmit",
    "bump": "node scripts/bump-version.mjs",
    "release": "pnpm build && pnpm -r publish --registry=https://registry.npmjs.org"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@poco-ai/agentero-dsh-host": "workspace:^",
    "@poco-ai/agentero-dsh-library": "workspace:^",
    "@poco-ai/agentero-dsh-notes": "workspace:^",
    "@poco-ai/agentero-dsh-pdf": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.1",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-store": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-alpha.2",
    "@deepseek-ai/schemastery": "3.18.6-alpha.1",
    "@tailwindcss/cli": "^4.1.16",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.18",
    "esbuild": "^0.25.0",
    "scheduler": "0.28.0",
    "tailwindcss": "^4.1.16",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poco-ai/agentero-dsh-plugin.git"
  }
}
